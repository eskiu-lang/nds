// sdat.esk: the DS sound archive (SDAT) and a synthesizer for its sequences.
//
//     Sdat s = Sdat_open("sound_data.sdat")?;
//     defer s.close();
//     Pcm16 pcm;
//     s.render(s.seq_find("SEQ_BGM_FIELD"), 30.0, &pcm)?;   // 30 s at 48 kHz
//     defer pcm.free();
//     pcm.write_wav("field.wav")?;
//
// An SDAT holds sequences (SSEQ, bytecode for the sound driver), sequence
// archives (SSAR, the sound effects: many sequences sharing one block of
// bytecode, each with its own bank and volume), instrument banks (SBNK),
// wave archives (SWAR, PCM8, PCM16 or IMA-ADPCM samples), streams (STRM,
// long PCM or ADPCM waves in blocks) and the SYMB names of each. The
// synthesizer is a port of the Tallgrass engine's (engine/src/sdat.rs),
// which models the DS driver:
//
// - The driver runs at about 192 Hz (64 * 2728 cycles of 33.51 MHz). Each
//   frame adds the tempo to an accumulator and runs one sequence tick for
//   every 240, then updates the envelope, volume, pitch and pan of each voice.
// - Volumes are in tenths of a dB: master, sequence, track, expression,
//   velocity and envelope are added (20 log10(x / 127)) and turned linear
//   when mixing.
// - ADSR envelopes use the driver's attack and fall rate tables.
// - Pitch is in 1/64 semitone: note minus the instrument's root, pitch bend
//   times its range / 2, and the modulation LFO.
//
// Output is 48 kHz stereo. The arithmetic, the libm calls and the order of
// the floating point operations are the Rust engine's, so the 16-bit output
// is the same sample for sample. Up to 32 voices sound at once (the oldest is
// stolen, released ones first). Two limits keep corrupt data from taking
// forever, and do not touch real sequences: a sequence may open at most 256
// tracks, and a tempo set from a variable is capped at 65535.

import <mem>;
import <fs>;
import <math>;
import <list>;
import <result>;
import <nds/bin>;
import <nds/wav>;

extern double log10(double x);
extern double sin(double x);
extern double round(double x);
extern double exp2(double x);
#ifdef __APPLE__
extern float __exp10f(float x);
#else
extern float powf(float x, float y);
#endif

// The sample rate the sequence renderer writes, in Hz.
const int SDAT_RATE = 48000;
const int _SD_AMPL_MIN = -92544;
const int _SD_MAX_VOICES = 32;
const int _SD_MAX_TRACKS = 256;

// One FAT entry: where a file of the archive is.
struct _SdFile {
    int64 off;
    int64 len;
}

struct _SdSeqInfo {
    bool present;
    int file;
    int bank;
    int vol;
}

struct _SdBankInfo {
    bool present;
    int file;
    int[4] wa;
}

struct _SdStrmInfo {
    bool present;
    int file;
    int vol;
}

// An SDAT sound archive: its files, the INFO records of its sequences, sequence archives,
// streams, banks and wave archives, and their SYMB names. Made by Sdat_open or Sdat_from;
// free it with close().
struct Sdat {
    NdsData d;
    bool owned;
    int nfiles;
    *_SdFile files;
    int nseqs;
    *_SdSeqInfo seqs;
    int nssars;
    *int ssars;
    int nstrms;
    *_SdStrmInfo strms;
    int nbanks;
    *_SdBankInfo banks;
    int nwavearcs;
    *int wavearcs;
    int nseq_names;
    *string seq_names;
    int nwavearc_names;
    *string wavearc_names;
    int nssar_names;
    *string ssar_names;
    *int nssar_entry_names;
    **string ssar_entry_names;
    int nstrm_names;
    *string strm_names;
}

// A decoded sample: mono 16-bit PCM, its rate, and the loop.
struct SdatWave {
    *int16 pcm;
    int64 len;
    double rate;
    bool looped;
    int64 loop_start;
}

// Frees the samples.
void SdatWave_free(SdatWave* self) {
    if (self.pcm != null) free((*void)self.pcm);
    self.pcm = null;
    self.len = 0;
}

// ---- the container ----

// INFO records of one category: the absolute offset of each, 0 for none.
// Entries past the end of the buffer are dropped: they would read as none.
int _sd_records(NdsData* d, int64 info, int cat, *int64* out) {
    *out = null;
    int64 r = d.u32(info + 8 + (int64)cat * 4);
    if (r == 0) return 0;
    int64 n = d.u32(info + r);
    int64 room = (d.len - (info + r + 4)) / 4;
    if (room < 0) room = 0;
    if (n > room) n = room;
    if (n == 0) return 0;
    *int64 o = alloc<int64>(n);
    for (int64 i = 0; i < n; i++) {
        int64 v = d.u32(info + r + 4 + i * 4);
        o[i] = v == 0 ? (int64)0 : info + v;
    }
    *out = o;
    return (int)n;
}

// SYMB names of one category; a missing name is null.
int _sd_names(NdsData* d, int64 symb, int cat, *string* out) {
    *out = null;
    if (symb == 0) return 0;
    return _sd_names_at(d, symb, d.u32(symb + 8 + (int64)cat * 4), out);
}

// The SYMB names of the record at symb + r (a count, then an offset from
// symb for each name).
int _sd_names_at(NdsData* d, int64 symb, int64 r, *string* out) {
    *out = null;
    if (r == 0) return 0;
    int64 n = d.u32(symb + r);
    int64 room = (d.len - (symb + r + 4)) / 4;
    if (room < 0) room = 0;
    if (n > room) n = room;
    if (n == 0) return 0;
    *string names = alloc<string>(n);
    for (int64 i = 0; i < n; i++) {
        int64 no = d.u32(symb + r + 4 + i * 4);
        if (no == 0 || symb + no >= d.len) continue;
        names[i] = d.str(symb + no, d.len);
    }
    *out = names;
    return (int)n;
}

// Reads an SDAT that stays in the caller's memory until close.
Result<Sdat, string> Sdat_from(*uint8 data, int64 len) {
    let s: Sdat;
    s.d = NdsData{data: data, len: len};
    NdsData* d = &s.d;
    if (!d.magic(0, "SDAT")) return Err<Sdat, string>("sdat: not an SDAT file");
    int nblk = d.u16(14);
    int64 symb = nblk > 0 ? d.u32(0x10) : (int64)0;
    int64 info = nblk > 1 ? d.u32(0x18) : (int64)0;
    int64 fat = nblk > 2 ? d.u32(0x20) : (int64)0;
    if (info == 0 || fat == 0) return Err<Sdat, string>("sdat: no INFO or FAT block");
    *int64 rec = null;
    int n = _sd_records(d, info, 0, &rec);
    s.nseqs = n;
    s.seqs = alloc<_SdSeqInfo>((int64)n + 1);
    for (i in 0..n) {
        int64 o = rec[i];
        if (o == 0) continue;
        s.seqs[i] = _SdSeqInfo{present: true, file: d.u16(o), bank: d.u16(o + 4), vol: d.u8(o + 6)};
    }
    if (rec != null) free((*void)rec);
    n = _sd_records(d, info, 2, &rec);
    s.nbanks = n;
    s.banks = alloc<_SdBankInfo>((int64)n + 1);
    for (i in 0..n) {
        int64 o = rec[i];
        if (o == 0) continue;
        s.banks[i].present = true;
        s.banks[i].file = d.u16(o);
        for (k in 0..4) s.banks[i].wa[k] = d.u16(o + 4 + (int64)k * 2);
    }
    if (rec != null) free((*void)rec);
    n = _sd_records(d, info, 3, &rec);
    s.nwavearcs = n;
    s.wavearcs = alloc<int>((int64)n + 1);
    for (i in 0..n) s.wavearcs[i] = rec[i] == 0 ? -1 : d.u16(rec[i]);
    if (rec != null) free((*void)rec);
    int64 nf = d.u32(fat + 8);
    int64 room = (len - (fat + 12)) / 16;
    if (room < 0) room = 0;
    if (nf > room) nf = room;
    s.nfiles = (int)nf;
    s.files = alloc<_SdFile>(nf + 1);
    for (int64 i = 0; i < nf; i++) {
        s.files[i] = _SdFile{off: d.u32(fat + 12 + i * 16), len: d.u32(fat + 16 + i * 16)};
    }
    n = _sd_records(d, info, 1, &rec);
    s.nssars = n;
    s.ssars = alloc<int>((int64)n + 1);
    for (i in 0..n) s.ssars[i] = rec[i] == 0 ? -1 : d.u16(rec[i]);
    if (rec != null) free((*void)rec);
    n = _sd_records(d, info, 7, &rec);
    s.nstrms = n;
    s.strms = alloc<_SdStrmInfo>((int64)n + 1);
    for (i in 0..n) {
        if (rec[i] != 0) s.strms[i] = _SdStrmInfo{present: true, file: d.u16(rec[i]), vol: d.u8(rec[i] + 4)};
    }
    if (rec != null) free((*void)rec);
    s.nseq_names = _sd_names(d, symb, 0, &s.seq_names);
    s.nwavearc_names = _sd_names(d, symb, 3, &s.wavearc_names);
    s.nstrm_names = _sd_names(d, symb, 7, &s.strm_names);
    _sd_ssar_names(&s, symb);
    return Ok<Sdat, string>(s);
}

// Reads an SDAT file into memory.
Result<Sdat, string> Sdat_open(string path) {
    int64 n = 0;
    *uint8 p = fs_read_all(path, &n);
    if (p == null) return Err<Sdat, string>("sdat: cannot read the file");
    Result<Sdat, string> r = Sdat_from(p, n);
    if (!r.ok) {
        free((*void)p);
        return r;
    }
    r.value.owned = true;
    return r;
}

void _sd_free_names(*string names, int n) {
    if (names == null) return;
    for (i in 0..n) {
        if (names[i] != null) free((*void)names[i]);
    }
    free((*void)names);
}

// The SEQARC names of SYMB have two levels: each archive's name, then a
// record with the names of its sequences.
void _sd_ssar_names(Sdat* s, int64 symb) {
    if (symb == 0) return;
    NdsData* d = &s.d;
    int64 r = d.u32(symb + 8 + 4);
    if (r == 0) return;
    int64 n = d.u32(symb + r);
    int64 room = (d.len - (symb + r + 4)) / 8;
    if (room < 0) room = 0;
    if (n > room) n = room;
    if (n == 0) return;
    s.nssar_names = (int)n;
    s.ssar_names = alloc<string>(n);
    s.nssar_entry_names = alloc<int>(n);
    s.ssar_entry_names = alloc<*string>(n);
    for (int64 i = 0; i < n; i++) {
        int64 no = d.u32(symb + r + 4 + i * 8);
        int64 sub = d.u32(symb + r + 8 + i * 8);
        if (no != 0 && symb + no < d.len) s.ssar_names[i] = d.str(symb + no, d.len);
        s.nssar_entry_names[i] = _sd_names_at(d, symb, sub, &s.ssar_entry_names[i]);
    }
}

// Frees the archive (and its bytes when it read them from a file).
void Sdat_close(Sdat* self) {
    if (self.files != null) free((*void)self.files);
    if (self.seqs != null) free((*void)self.seqs);
    if (self.ssars != null) free((*void)self.ssars);
    if (self.strms != null) free((*void)self.strms);
    _sd_free_names(self.ssar_names, self.nssar_names);
    _sd_free_names(self.strm_names, self.nstrm_names);
    if (self.ssar_entry_names != null) {
        for (i in 0..self.nssar_names) _sd_free_names(self.ssar_entry_names[i], self.nssar_entry_names[i]);
        free((*void)self.ssar_entry_names);
        free((*void)self.nssar_entry_names);
    }
    self.ssars = null;
    self.strms = null;
    self.ssar_names = null;
    self.strm_names = null;
    self.ssar_entry_names = null;
    self.nssar_entry_names = null;
    self.nssars = 0;
    self.nstrms = 0;
    self.nssar_names = 0;
    self.nstrm_names = 0;
    if (self.banks != null) free((*void)self.banks);
    if (self.wavearcs != null) free((*void)self.wavearcs);
    _sd_free_names(self.seq_names, self.nseq_names);
    _sd_free_names(self.wavearc_names, self.nwavearc_names);
    if (self.owned && self.d.data != null) free((*void)self.d.data);
    self.files = null;
    self.seqs = null;
    self.banks = null;
    self.wavearcs = null;
    self.seq_names = null;
    self.wavearc_names = null;
    self.d = NdsData{data: null, len: 0};
    self.owned = false;
}

// File id of the FAT as a view; an empty view when the entry is missing or
// points outside the archive.
NdsData Sdat_file(Sdat* self, int id) {
    if (id < 0 || id >= self.nfiles) return NdsData{data: null, len: 0};
    return self.d.sub(self.files[id].off, self.files[id].len);
}

// Sequence slots in the INFO block (some may be empty).
int Sdat_seq_count(Sdat* self) {
    return self.nseqs;
}

// True when sequence i exists.
bool Sdat_has_seq(Sdat* self, int i) {
    return i >= 0 && i < self.nseqs && self.seqs[i].present;
}

// The SYMB name of sequence i, or null.
string Sdat_seq_name(Sdat* self, int i) {
    if (i < 0 || i >= self.nseq_names) return null;
    return self.seq_names[i];
}

int _sd_find(*string names, int n, string name) {
    for (int i = n - 1; i >= 0; i--) {
        if (names[i] != null && strcmp(names[i], name) == 0) return i;
    }
    return -1;
}

// The index of the sequence named name, or -1. When two share a name the
// last one wins, as in the engine.
int Sdat_seq_find(Sdat* self, string name) {
    return _sd_find(self.seq_names, self.nseq_names, name);
}

// Wave archive slots in the INFO block (some may be empty).
int Sdat_wavearc_count(Sdat* self) {
    return self.nwavearcs;
}

// The SYMB name of wave archive i, or null.
string Sdat_wavearc_name(Sdat* self, int i) {
    if (i < 0 || i >= self.nwavearc_names) return null;
    return self.wavearc_names[i];
}

// The index of the wave archive named name, or -1 (the last one when two share it).
int Sdat_wavearc_find(Sdat* self, string name) {
    return _sd_find(self.wavearc_names, self.nwavearc_names, name);
}

// The FAT file of wave archive i, or -1.
int _sd_wavearc_file(Sdat* self, int i) {
    if (i < 0 || i >= self.nwavearcs) return -1;
    return self.wavearcs[i];
}

// ---- samples (SWAV inside a SWAR) ----

int[89] _SD_ADPCM_STEP = {
    7, 8, 9, 10, 11, 12, 13, 14, 16, 17, 19, 21, 23, 25, 28, 31, 34, 37, 41, 45, 50, 55, 60, 66, 73, 80, 88, 97,
    107, 118, 130, 143, 157, 173, 190, 209, 230, 253, 279, 307, 337, 371, 408, 449, 494, 544, 598, 658, 724, 796,
    876, 963, 1060, 1166, 1282, 1411, 1552, 1707, 1878, 2066, 2272, 2499, 2749, 3024, 3327, 3660, 4026, 4428,
    4871, 5358, 5894, 6484, 7132, 7845, 8630, 9493, 10442, 11487, 12635, 13899, 15289, 16818, 18500, 20350,
    22385, 24623, 27086, 29794, 32767
};

int[16] _SD_ADPCM_INDEX = {-1, -1, -1, -1, 2, 4, 6, 8, -1, -1, -1, -1, 2, 4, 6, 8};

// IMA-ADPCM: a 4-byte header (first sample, step index), then two samples
// per byte, low nibble first.
int64 _sd_adpcm(NdsData d, *int16 out) {
    if (d.len < 4) return 0;
    int pred = d.s16(0);
    int index = d.u16(2) & 0x7F;
    if (index > 88) index = 88;
    int64 k = 0;
    for (int64 i = 4; i < d.len; i++) {
        int byte = (int)d.data[i];
        for (h in 0..2) {
            int nib = h == 0 ? byte & 15 : byte >> 4;
            int step = _SD_ADPCM_STEP[index];
            int diff = step >> 3;
            if ((nib & 1) != 0) diff += step >> 2;
            if ((nib & 2) != 0) diff += step >> 1;
            if ((nib & 4) != 0) diff += step;
            if ((nib & 8) != 0) {
                pred = pred - diff;
                if (pred < -32768) pred = -32768;
            } else {
                pred = pred + diff;
                if (pred > 32767) pred = 32767;
            }
            index += _SD_ADPCM_INDEX[nib];
            if (index < 0) index = 0;
            if (index > 88) index = 88;
            out[k] = (int16)pred;
            k++;
        }
    }
    return k;
}

int64 _sd_sat_sub(int64 a, int64 b) {
    return a > b ? a - b : (int64)0;
}

// Decodes wave index of a SWAR.
Result<SdatWave, string> sdat_swav(NdsData swar, int index) {
    if (!swar.magic(0, "SWAR")) return Err<SdatWave, string>("sdat: not a SWAR");
    int64 base = 0x10 + 8 + 32;
    int64 n = swar.u32(base);
    if (index < 0 || (int64)index >= n) return Err<SdatWave, string>("sdat: no such wave");
    int64 off = swar.u32(base + 4 + (int64)index * 4);
    int64 end = (int64)index + 1 < n ? swar.u32(base + 8 + (int64)index * 4) : swar.len;
    if (end < off) end = off;
    if (end > swar.len) return Err<SdatWave, string>("sdat: wave out of range");
    NdsData b = swar.sub(off, end - off);
    if (b.len < 13) return Err<SdatWave, string>("sdat: wave too short");
    int kind = b.u8(0);
    bool looped = b.u8(1) != 0;
    int rate = b.u16(2);
    int64 ls = b.u16(6);
    int64 ll = b.u32(8);
    NdsData data = b.sub(12, b.len - 12);
    let w: SdatWave;
    int64 loop_start = 0;
    int64 total = 0;
    if (kind == 0) {
        w.pcm = alloc<int16>(data.len + 1);
        for (int64 i = 0; i < data.len; i++) w.pcm[i] = (int16)((int)(int8)data.data[i] << 8);
        w.len = data.len;
        loop_start = ls * 4;
        total = (ls + ll) * 4;
    } else if (kind == 1) {
        int64 m = data.len / 2;
        w.pcm = alloc<int16>(m + 1);
        for (int64 i = 0; i < m; i++) w.pcm[i] = (int16)data.s16(i * 2);
        w.len = m;
        loop_start = ls * 2;
        total = (ls + ll) * 2;
    } else {
        int64 m = data.len >= 4 ? (data.len - 4) * 2 : (int64)0;
        w.pcm = alloc<int16>(m + 1);
        w.len = _sd_adpcm(data, w.pcm);
        loop_start = _sd_sat_sub(ls * 4, 4) * 2;
        total = _sd_sat_sub((ls + ll) * 4, 4) * 2;
    }
    if (total > 0 && total < w.len) w.len = total;
    if (w.len == 0) {
        free((*void)w.pcm);
        return Err<SdatWave, string>("sdat: empty wave");
    }
    if (loop_start > w.len - 1) loop_start = w.len - 1;
    w.loop_start = loop_start;
    w.looped = looped;
    w.rate = (double)(rate < 1 ? 1 : rate);
    return Ok<SdatWave, string>(w);
}

// Wave index of wave archive wavearc (a cry is wave 0 of its archive).
Result<SdatWave, string> Sdat_wave(Sdat* self, int wavearc, int index) {
    int f = _sd_wavearc_file(self, wavearc);
    if (f < 0) return Err<SdatWave, string>("sdat: no such wave archive");
    return sdat_swav(self.file(f), index);
}

// ---- streams (STRM) ----

// A decoded stream: 16-bit PCM, channels interleaved (left first), at the
// stream's rate; loop_start is in sample frames.
struct SdatStream {
    Pcm16 pcm;
    int kind;
    bool looped;
    int64 loop_start;
    int vol;
}

// Frees the stream's samples.
void SdatStream_free(SdatStream* self) {
    self.pcm.free();
}

// Decodes a STRM file. Its HEAD block gives the format (0 PCM8, 1 PCM16, 2
// IMA-ADPCM), the loop, the channels, the rate, the sample count and the
// blocks: the DATA block holds block 0 of each channel, then block 1 of each
// channel, and so on, the last one shorter. An ADPCM block starts with its
// own header, as a SWAV's data does.
Result<SdatStream, string> sdat_strm(NdsData f) {
    if (!f.magic(0, "STRM")) return Err<SdatStream, string>("sdat: not a STRM");
    if (!f.magic(0x10, "HEAD") || f.len < 0x60) return Err<SdatStream, string>("sdat: truncated STRM header");
    int kind = f.u8(0x18);
    int ch = f.u8(0x1A);
    int rate = f.u16(0x1C);
    int64 nsamples = f.u32(0x24);
    int64 data = f.u32(0x28);
    int64 nblocks = f.u32(0x2C);
    int64 blen = f.u32(0x30);
    int64 bsamples = f.u32(0x34);
    int64 lastlen = f.u32(0x38);
    int64 lastsamples = f.u32(0x3C);
    if (kind > 2) return Err<SdatStream, string>("sdat: unknown STRM wave format");
    if (ch < 1 || ch > 16) return Err<SdatStream, string>("sdat: bad STRM channel count");
    if (nblocks < 1 || blen < 0 || lastlen < 0 || bsamples < 0 || lastsamples < 0) return Err<SdatStream, string>("sdat: bad STRM blocks");
    // every block of every channel must be inside the file
    int64 full = nblocks - 1;
    if (full > 0 && blen > (f.len - data) / full / (int64)ch) return Err<SdatStream, string>("sdat: STRM blocks out of range");
    if (!f.has(data, full * blen * (int64)ch + lastlen * (int64)ch)) return Err<SdatStream, string>("sdat: STRM blocks out of range");
    // no block holds more samples than its bytes can encode
    int64 most = kind == 0 ? blen : (kind == 1 ? blen / 2 : (blen > 4 ? (blen - 4) * 2 : (int64)0));
    int64 most_last = kind == 0 ? lastlen : (kind == 1 ? lastlen / 2 : (lastlen > 4 ? (lastlen - 4) * 2 : (int64)0));
    if (bsamples > most) bsamples = most;
    if (lastsamples > most_last) lastsamples = most_last;
    int64 per = full * bsamples + lastsamples;
    if (nsamples < per) per = nsamples;
    let s: SdatStream;
    s.kind = kind;
    s.looped = f.u8(0x19) != 0;
    s.loop_start = f.u32(0x20);
    s.vol = 127;
    s.pcm = Pcm16{data: alloc<int16>(per * (int64)ch + 1), frames: per, channels: ch, rate: rate < 1 ? 1 : rate};
    int64 maxlen = blen > lastlen ? blen : lastlen;
    *int16 tmp = alloc<int16>(maxlen * 2 + 2);
    defer free((*void)tmp);
    for (c in 0..ch) {
        int64 at = 0;
        for (int64 b = 0; b < nblocks && at < per; b++) {
            bool last = b == nblocks - 1;
            int64 len = last ? lastlen : blen;
            int64 want = last ? lastsamples : bsamples;
            NdsData blk = f.sub(data + b * blen * (int64)ch + (int64)c * len, len);
            int64 got = 0;
            if (kind == 0) {
                for (int64 i = 0; i < blk.len; i++) tmp[i] = (int16)((int)(int8)blk.data[i] << 8);
                got = blk.len;
            } else if (kind == 1) {
                for (int64 i = 0; i < blk.len / 2; i++) tmp[i] = (int16)blk.s16(i * 2);
                got = blk.len / 2;
            } else {
                got = _sd_adpcm(blk, tmp);
            }
            if (got > want) got = want;
            if (got > per - at) got = per - at;
            for (int64 i = 0; i < got; i++) s.pcm.data[(at + i) * (int64)ch + (int64)c] = tmp[i];
            at += got;
        }
    }
    if (s.loop_start > per) s.loop_start = per;
    return Ok<SdatStream, string>(s);
}

// Stream slots in the INFO block (some may be empty).
int Sdat_strm_count(Sdat* self) {
    return self.nstrms;
}

// The SYMB name of stream i, or null.
string Sdat_strm_name(Sdat* self, int i) {
    if (i < 0 || i >= self.nstrm_names) return null;
    return self.strm_names[i];
}

// The index of the stream named name, or -1 (the last one when two share it).
int Sdat_strm_find(Sdat* self, string name) {
    return _sd_find(self.strm_names, self.nstrm_names, name);
}

// Stream i decoded, with the volume of its INFO record.
Result<SdatStream, string> Sdat_stream(Sdat* self, int i) {
    if (i < 0 || i >= self.nstrms || !self.strms[i].present) return Err<SdatStream, string>("sdat: no such stream");
    SdatStream s = sdat_strm(self.file(self.strms[i].file))?;
    s.vol = self.strms[i].vol;
    return Ok<SdatStream, string>(s);
}

import "sdat_seq.esk";
import "sdat_player.esk";
import "sdat_mix.esk";
