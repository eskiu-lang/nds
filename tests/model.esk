// NSBTX textures in each of the seven formats and an NSBMD's materials and
// triangles, against tools/gen_test_data.py's expectations
// (tests/data/textures.txt, model.txt and the .rgba files).
import <io>;
import <mem>;
import <fs>;
import <string>;
import <bytes>;
import <math>;
import <nds/bin>;
import <nds/image>;
import <nds/model>;

extern int atoi(string s);
extern double atof(string s);

int fails = 0;

void check(bool ok, string what) {
    if (!ok) {
        printf("FAIL %s\n", what);
        fails++;
    }
}

NdsData slurp(string name) {
    let p: Bytes;
    p.init(64);
    p.append_raw((*uint8)"tests/data/", 11);
    p.append_raw((*uint8)name, strlen(name));
    p.push(0);
    int64 n = 0;
    *uint8 d = fs_read_all((string)p.data, &n);
    p.free();
    return NdsData{data: d, len: n};
}

bool same_image(NdsImage* img, string name) {
    NdsData e = slurp(name);
    if (e.data == null) return false;
    defer free((*void)e.data);
    if (e.u32(0) != (int64)img.width || e.u32(4) != (int64)img.height) return false;
    int64 n = (int64)img.width * (int64)img.height * 4;
    return e.len == n + 8 && memcmp((*void)(e.data + 8), (*void)img.rgba, n) == 0;
}

// The words of each line of a text file (at most 16 lines of 16 words).
int split(NdsData* t, *string out, int max_words) {
    int n = 0;
    int64 i = 0;
    while (i < t.len && n < max_words) {
        while (i < t.len && (t.data[i] == 32 || t.data[i] == 10)) {
            t.data[i] = 0;
            i++;
        }
        if (i >= t.len) break;
        out[n] = (string)(t.data + i);
        n++;
        while (i < t.len && t.data[i] != 32 && t.data[i] != 10) i++;
    }
    if (i < t.len) t.data[i] = 0;
    return n;
}

void textures() {
    NdsData d = slurp("test.nsbtx");
    defer free((*void)d.data);
    Result<NdsTexSet, string> r = nds_texset(d.data, d.len);
    if (!r.ok) {
        check(false, r.error);
        return;
    }
    NdsTexSet ts = r.value;
    defer ts.free();
    check(ts.ntex == 7 && ts.npal == 6, "texture and palette counts");
    NdsData list = slurp("textures.txt");
    defer free((*void)list.data);
    *string w = alloc<string>(256);
    defer free((*void)w);
    int n = split(&list, w, 256);
    for (int k = 0; k + 5 < n + 1; k += 6) {
        int t = ts.find(w[k + 1]);
        check(t >= 0, "a texture by name");
        if (t < 0) continue;
        check(ts.tex[t].format == atoi(w[k + 2]) && ts.tex[t].width == atoi(w[k + 3]) && ts.tex[t].height == atoi(w[k + 4]), "texture format and size");
        int p = ts.palette_for(t);
        check(ts.tex[t].format == NDS_TEX_DIRECT || (p >= 0 && strcmp(ts.pal[p].name, ts.tex[t].name) == 0), "the palette of the same name");
        Result<NdsImage, string> img = ts.image(t, ts.tex[t].format == NDS_TEX_DIRECT ? -1 : p);
        if (!img.ok) {
            check(false, img.error);
            continue;
        }
        if (!same_image(&img.value, w[k + 5])) {
            printf("  texture %s (format %s)\n", w[k + 1], w[k + 2]);
            check(false, "texture pixels");
        }
        img.value.free();
    }
    check(!ts.image(7, 0).ok && !ts.image(-1, 0).ok, "a missing texture");
    check(ts.find("nope") == -1 && ts.find_palette("nope") == -1, "missing names");
}

void model() {
    NdsData d = slurp("test.nsbmd");
    defer free((*void)d.data);
    Result<NdsModel, string> r = nsbmd_read(d.data, d.len);
    if (!r.ok) {
        check(false, r.error);
        return;
    }
    NdsModel m = r.value;
    defer m.free();
    check(strcmp(m.name, "testmodel") == 0 && m.scale == (float)2.0, "model name and scale");
    check(m.nmaterials == 2 && strcmp(m.materials[0].name, "mat_floor") == 0 && strcmp(m.materials[1].texture, "four") == 0 && strcmp(m.materials[0].palette, "sixteen") == 0, "materials");
    check(m.groups.size == 2 && m.triangles() == 5, "groups and triangles");
    NdsData list = slurp("model.txt");
    defer free((*void)list.data);
    *string w = alloc<string>(512);
    defer free((*void)w);
    int n = split(&list, w, 512);
    int[2] seen = {0, 0};
    bool ok = true;
    for (int k = 4; k + 11 < n + 1 && strcmp(w[k], "tri") == 0; k += 12) {
        int mat = atoi(w[k + 1]);
        NdsMeshGroup* g = &m.groups.data[mat];
        if (g.material != mat || strcmp(m.materials[mat].texture, w[k + 2]) != 0) ok = false;
        int t = seen[mat];
        seen[mat]++;
        if ((t + 1) * 3 > g.verts.size) {
            ok = false;
            continue;
        }
        for (j in 0..3) {
            NdsVertex* v = &g.verts.data[t * 3 + j];
            double x = atof(w[k + 3 + j * 3]);
            double y = atof(w[k + 4 + j * 3]);
            double z = atof(w[k + 5 + j * 3]);
            if (fabs((double)v.x - x) > 1e-5 || fabs((double)v.y - y) > 1e-5 || fabs((double)v.z - z) > 1e-5) ok = false;
        }
    }
    check(ok && seen[0] == 2 && seen[1] == 3, "triangles");
    NdsVertex* q = &m.groups.data[0].verts.data[1];
    check(m.groups.data[0].has_normals && m.groups.data[0].has_colors && !m.groups.data[1].has_normals, "normals and colors");
    check(q.s == (float)4.0 && q.t == (float)6.0 && q.r == (float)1.0 && fabs((double)q.ny - 0.998046875) < 1e-6, "texture coordinates, color, normal");
    // the model's own textures, paired by its materials
    Result<NdsTexSet, string> ts = nds_texset(d.data, d.len);
    check(ts.ok && ts.value.ntex == 7, "the model's texture block");
    if (ts.ok) {
        int t = ts.value.find("four");
        check(strcmp(ts.value.pal[m.palette_for(&ts.value, t)].name, "four") == 0, "material palette pairing");
        ts.value.free();
    }
    check(!nsbmd_read(d.data, 64).ok, "a truncated model");
    // materials, nodes and inverse bind matrices
    NdsMaterial* m0 = &m.materials[0];
    NdsMaterial* m1 = &m.materials[1];
    check(m0.diffuse == 0x1F && m0.ambient == 0x3E0 && m0.emission == 0x7C00 && m0.alpha == 31 && !m0.cull_back && m0.cull_front, "material colors and culling");
    check(m0.width == 8 && m0.height == 16 && (m0.tex_params >> 16 & 3) == 3 && !m0.has_tex_matrix, "material texture state");
    check(m1.diffuse_is_vertex_color && m1.alpha == 16 && !m1.cull_back && !m1.cull_front && m1.has_tex_matrix && m1.tex_scale[0] == 2.0 && m1.tex_scale[1] == 0.5, "material texture matrix");
    check(m.nnodes == 3 && strcmp(m.nodes[1].name, "arm") == 0 && m.ninv == 3, "nodes");
    NdsNode* arm = &m.nodes[1];
    check(arm.has_t && arm.has_r && !arm.has_s && arm.t[0] == 2.0 && arm.r[5] == 1.0 && arm.r[7] == -1.0 && arm.matrix.m[12] == 2.0, "pivot rotation node");
    NdsNode* tip = &m.nodes[2];
    check(!tip.has_t && tip.has_r && tip.has_s && tip.r[1] == 1.0 && tip.r[3] == -1.0 && tip.s[2] == 2.0 && tip.matrix.m[4] == -2.0, "full rotation node");
    check(m.inv_binds[0].m[13] == -1.0 && m.inv_binds[1].m[9] == 1.0 && m.inv_binds[1].m[14] == 1.0, "inverse bind matrices");
    check(nsbmd_count(d.data, d.len) == 1 && !nsbmd_open(d.data, d.len, 1).ok, "model count");
    // the posed mesh
    Result<NdsMesh, string> mr = m.mesh();
    if (!mr.ok) {
        check(false, mr.error);
        return;
    }
    NdsMesh me = mr.value;
    defer me.free();
    check(me.prims.size == 2 && me.indices.size == 15 && me.verts.size == 11, "mesh primitives");
    int t = 0;
    bool same = true;
    for (int k = 4; k + 11 < n + 1; k += 12) {
        if (strcmp(w[k], "mesh") != 0) continue;
        for (j in 0..3) {
            NdsMeshVertex* v = &me.verts.data[me.indices.data[t * 3 + j]];
            for (c in 0..3) {
                if (fabs((double)v.pos[c] - atof(w[k + 3 + j * 3 + c])) > 1e-5) same = false;
            }
        }
        t++;
    }
    check(same && t == 5, "mesh positions");
    // joints: root, then arm under it; the floor follows the root, the wall both
    check(me.joints.size == 2 && me.joints.data[0].node == 0 && me.joints.data[1].node == 1 && me.joints.data[1].parent == 0, "joints");
    NdsMeshVertex* f0 = &me.verts.data[0];
    NdsMeshVertex* w0 = &me.verts.data[5];
    check(f0.joints[0] == 0 && f0.weights[0] == (float)1.0 && f0.weights[1] == (float)0.0, "floor weights");
    check(w0.weights[0] == (float)0.5 && w0.weights[1] == (float)0.5 && w0.joints[0] + w0.joints[1] == 1 && me.max_influences == 2 && me.over4 == 0, "wall weights");
    check(fabs((double)me.joints.data[1].inv_bind.m[14] - 1.0) < 1e-9 && fabs((double)me.joints.data[1].inv_bind.m[12] + 2.0) < 1e-9, "joint inverse bind");
    check(f0.uv[0] == (float)0.0 && me.verts.data[1].uv[0] == (float)0.5 && me.verts.data[1].uv[1] == (float)0.375 && fabs((double)f0.normal[1] - 1.0) < 1e-6, "mesh texture coordinates and normals");
    check(me.prims.data[0].has_colors && !me.prims.data[1].has_colors && me.verts.data[5].color[0] == (float)1.0, "vertex colors");
    float[3] lo;
    float[3] hi;
    me.bounds(&lo[0], &hi[0]);
    check(lo[0] == (float)-4.0 && hi[2] == (float)12.0, "mesh bounds");
}

textures();
model();
if (fails > 0) return 1;
printf("model: ok\n");
