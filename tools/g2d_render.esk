// Renders 2D graphics files to raw RGBA for tools/compare_graphics.py:
//
//     g2d_render screen NSCR NCGR NCLR OUT [transparent0]
//     g2d_render sheet NCGR NCLR OUT
//     g2d_render cells NCER                  (prints each cell's objects)
//
// OUT gets the width and height as two little-endian uint32, then the
// pixels. Each input may be LZ-compressed.
import <io>;
import <mem>;
import <fs>;
import <string>;
import <bytes>;
import <nds/bin>;
import <nds/lz>;
import <nds/image>;
import <nds/graphics>;

Result<Bytes, string> load(string path) {
    NdsData d = nds_read_file(path)?;
    Result<Bytes, string> b = nds_unpack(d.data, d.len);
    free((*void)d.data);
    return b;
}

Result<int, string> save(NdsImage* img, string path) {
    let b: Bytes;
    b.init((int64)img.width * (int64)img.height * 4 + 8);
    uint8[8] hdr;
    for (k in 0..4) {
        hdr[k] = (uint8)(img.width >> (k * 8));
        hdr[k + 4] = (uint8)(img.height >> (k * 8));
    }
    b.append_raw(&hdr[0], 8);
    b.append_raw(img.rgba, (int64)img.width * (int64)img.height * 4);
    int ok = fs_write_all(path, b.data, b.len);
    b.free();
    if (ok == 0) return Err<int, string>("cannot write");
    return Ok<int, string>(0);
}

Result<int, string> run(int n, *string a) {
    if (strcmp(a[1], "screen") == 0) {
        Bytes s = load(a[2])?;
        Bytes g = load(a[3])?;
        Bytes p = load(a[4])?;
        NdsScreen scr = nscr_read(s.data, s.len)?;
        NdsTiles t = ncgr_read(g.data, g.len)?;
        NdsPalette pal = nclr_read(p.data, p.len)?;
        NdsImage img = nds_render_screen(&scr, &t, &pal, n > 6);
        save(&img, a[5])?;
        img.free();
        scr.free();
        t.free();
        pal.free();
        s.free();
        g.free();
        p.free();
    } else if (strcmp(a[1], "sheet") == 0) {
        Bytes g = load(a[2])?;
        Bytes p = load(a[3])?;
        NdsTiles t = ncgr_read(g.data, g.len)?;
        NdsPalette pal = nclr_read(p.data, p.len)?;
        NdsImage img = t.sheet(&pal, 32, 0);
        save(&img, a[4])?;
        img.free();
        t.free();
        pal.free();
        g.free();
        p.free();
    } else if (strcmp(a[1], "cells") == 0) {
        Bytes c = load(a[2])?;
        NdsCells cells = ncer_read(c.data, c.len)?;
        for (i in 0..cells.count) {
            for (k in 0..cells.n[i]) {
                NdsOam* o = cells.oam(i, k);
                printf("%d %d %d %d %d %d %d %d %d %d\n", i, o.x, o.y, o.w, o.h, o.tile, o.hflip ? 1 : 0, o.vflip ? 1 : 0, o.mode, o.palette);
            }
        }
        cells.free();
        c.free();
    } else {
        return Err<int, string>("unknown command");
    }
    return Ok<int, string>(0);
}

if (argc < 3) {
    printf("usage: g2d_render screen|sheet|cells FILES...\n");
    return 1;
}

Result<int, string> r = run(argc, argv);
if (!r.ok) {
    printf("error: %s\n", r.error);
    return 1;
}
